{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "golypal.vercel.app" }], "destination": "https://www.golasvisuals.com/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
