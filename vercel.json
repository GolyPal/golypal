{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "golasvisuals.com" }], "destination": "/coming-soon.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.golasvisuals.com" }], "destination": "/coming-soon.html" },
    { "source": "/(.*)", "destination": "/app.html" }
  ]
}
